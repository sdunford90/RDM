generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id
  email           String?  @unique
  firstName       String?
  lastName        String?
  profileImageUrl String?
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())
}

model Asset {
  id           String   @id @default(uuid())
  label        String   @default("")
  address      String   @default("")
  lat          Float?
  lng          Float?
  notes        String   @default("")
  stage        String   @default("lead")

  // JSON blobs — Regrid parcel data, AirROI market data, underwriting model
  parcel           Json?
  market           Json?
  underwriting     Json?
  adjacentParcels  Json?

  // Market relation
  marketId     String?
  marketRef    Market?  @relation(fields: [marketId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Market {
  id           String   @id @default(uuid())
  name         String   @unique
  lat          Float
  lng          Float

  // Key metrics snapshot
  adr          Float?
  occupancy    Float?
  revpar       Float?
  monthlyRev   Float?
  listings     Int?
  supplyGrowth Float?

  // Composite score 0-100
  score        Float?

  // Full market data blob
  data         Json?

  assets       Asset[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
