generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id
  email           String?  @unique
  firstName       String?
  lastName        String?
  profileImageUrl String?
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())
}

model Asset {
  id           String   @id @default(uuid())
  label        String   @default("")
  address      String   @default("")
  lat          Float?
  lng          Float?
  notes        String   @default("")

  // JSON blobs — Regrid parcel data, AirROI market data, underwriting model
  parcel           Json?
  market           Json?
  underwriting     Json?
  adjacentParcels  Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
